# LLM Orchestrator Provider: ibm_bob (preferred) or gemini
LLM_PROVIDER=ibm_bob

# IBM Bob API Key for autonomous headless reasoning via Bob CLI
BOBSHELL_API_KEY=your_bobshell_api_key_here
BOB_BINARY=bob

# Google Gemini API Key for alternative cloud LLM reasoning
GEMINI_API_KEY=your_gemini_api_key_here

# Preferred Gemini model: gemini-3.5-flash (recommended for high throughput & quotas)
# Alternate choices: gemini-3.5-flash-lite, gemini-2.5-flash-lite, gemini-pro-latest
GEMINI_MODEL=gemini-3.5-flash

# Dynamic package lookup JSON store (mount persistent volume or local file path)
PACKAGE_LOOKUP_PATH=./backend/data/packages_lookup.json
